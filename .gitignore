node_modules/
dist/
.DS_Store
.vercel

# Secrets — keys live only in Supabase secrets, Vercel env and .env.local
.env
.env.*
!.env.example

# Tauri / Rust build artifacts
frontend/src-tauri/target/
frontend/src-tauri/gen/

# Test output
playwright-report/
test-results/

# Installer binaries are hosted in Vercel Blob storage (vercel.json redirects
# /downloads/* there). The AppImage alone exceeds GitHub's 100 MB file limit.
frontend/public/downloads/VignanExam*

# Model weights — far over GitHub's 100 MB file limit; keep local only
# (backend/training/models, backend/training/runs/*/weights). Detection in the
# app uses frontend/public/ai/models/.
*.pt
!frontend/public/ai/models/*.pt
# Downloaded training images are re-pulled by backend/training/pull_export.py
backend/training/datasets/*/images/
venv/
