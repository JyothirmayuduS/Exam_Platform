# Copy this file to `.env.local` and fill in your real values.
# `.env.local` is gitignored, so your keys never get committed.

# Supabase — Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# LiveKit — Cloud dashboard or self-hosted server URL (wss://...)
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# Where the Tauri lockdown desktop app boots straight into.
# Students never see onboarding — the exe opens this path in kiosk mode.
VITE_EXAM_ENTRY_PATH=/student/exam

# Lockdown desktop app download links. When a student opens the exam in a normal
# browser (not the Tauri app), they hit a download gate with a button pointing at
# the installer for their OS. Set a single base URL, or per-OS overrides.
VITE_LOCKDOWN_DOWNLOAD_URL=https://downloads.vignan.exam/lockdown
# Optional per-OS overrides (take precedence over the base URL above):
VITE_LOCKDOWN_DOWNLOAD_WIN=https://downloads.vignan.exam/lockdown/VignanExam_setup.exe
VITE_LOCKDOWN_DOWNLOAD_MAC=https://downloads.vignan.exam/lockdown/VignanExam.dmg
VITE_LOCKDOWN_DOWNLOAD_LINUX=https://downloads.vignan.exam/lockdown/VignanExam.AppImage

# When "true", the exam captures a proctoring screenshot every second and
# uploads it to Cloudflare R2 via the store-artifact edge function. Off by
# default so the prototype doesn't attempt uploads without a backend.
VITE_PROCTOR_CAPTURE=false

# ── Server-side only — NEVER prefix these with VITE_ and NEVER commit them ──
# Set as Supabase Edge Function secrets, not in this client env file:
#   supabase secrets set R2_ACCESS_KEY_ID=... R2_SECRET_ACCESS_KEY=... \
#     R2_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com R2_BUCKET=exam-artifacts
#   supabase secrets set LIVEKIT_API_KEY=... LIVEKIT_API_SECRET=... LIVEKIT_URL=wss://...
# The R2 secret access key and LiveKit API secret must never reach the browser.
